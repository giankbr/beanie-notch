<Window
    x:Class="Beanotch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Beanotch"
    Title="Beanotch">

    <Grid x:Name="Root" Background="#0B0B0C" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">

        <!-- Closed: a small island at the top centre, like the notch on a Mac. -->
        <Grid x:Name="Closed" Padding="14,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="ClosedIcon" Glyph="&#xE8D6;" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock x:Name="ClosedText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ClosedTrail" Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Dim}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Open: the panels. -->
        <Grid x:Name="Open" Visibility="Collapsed" Padding="16,12,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                    <SelectorBarItem Text="Now playing" Tag="music" IsSelected="True" />
                    <SelectorBarItem Text="Clipboard" Tag="clipboard" />
                    <SelectorBarItem Text="Prayer" Tag="prayer" />
                    <SelectorBarItem Text="AI usage" Tag="ai" />
                </SelectorBar>
                <Button Grid.Column="1" Click="OnQuit" ToolTipService.ToolTip="Quit Beanotch" Padding="8,4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7E8;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Now playing -->
            <Grid x:Name="MusicPage" Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="84" Height="84" CornerRadius="12" Background="{StaticResource Surface}">
                            <Image x:Name="Artwork" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="200">
                            <TextBlock x:Name="TrackTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TrackArtist" FontSize="13" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar x:Name="Progress" Maximum="1" Margin="0,6,0,0" />
                    <Grid>
                        <TextBlock x:Name="Elapsed" FontSize="11" Foreground="{StaticResource Faint}" FontFamily="Consolas" />
                        <TextBlock x:Name="Remaining" FontSize="11" Foreground="{StaticResource Faint}" FontFamily="Consolas" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Click="OnPrevious" Padding="12,8"><FontIcon Glyph="&#xE892;" FontSize="14" /></Button>
                        <Button Click="OnPlayPause" Padding="16,8" Style="{StaticResource AccentButtonStyle}"><FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="14" /></Button>
                        <Button Click="OnNext" Padding="12,8"><FontIcon Glyph="&#xE893;" FontSize="14" /></Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                    <TextBlock x:Name="LyricBefore" FontSize="14" Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LyricNow" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LyricAfter" FontSize="14" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Clipboard -->
            <Grid x:Name="ClipboardPage" Grid.Row="1" Visibility="Collapsed">
                <TextBlock x:Name="ClipboardEmpty" Text="Copy some text and it shows up here." Foreground="{StaticResource Faint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ListView x:Name="ClipList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnClipClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ClipItem">
                            <TextBlock Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" Padding="0,6" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Prayer times -->
            <Grid x:Name="PrayerPage" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="NEXT PRAYER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" CharacterSpacing="80" />
                    <TextBlock x:Name="NextPrayer" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="NextCountdown" FontSize="13" Foreground="{StaticResource Dim}" />
                    <ComboBox x:Name="CityPicker" Margin="0,10,0,0" MinWidth="200" SelectionChanged="OnCityChanged" />
                    <ComboBox x:Name="MethodPicker" MinWidth="200" SelectionChanged="OnMethodChanged" />
                </StackPanel>
                <ItemsControl x:Name="PrayerList" Grid.Column="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PrayerRow">
                            <Grid Padding="0,4" Opacity="{x:Bind Opacity}">
                                <TextBlock Text="{x:Bind Name}" FontSize="14" />
                                <TextBlock Text="{x:Bind Time}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- AI usage -->
            <Grid x:Name="AiPage" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="CLAUDE CODE · TODAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" CharacterSpacing="80" />
                    <TextBlock x:Name="AiCost" FontSize="30" FontWeight="Bold" />
                    <TextBlock x:Name="AiTokens" FontSize="13" Foreground="{StaticResource Dim}" />
                    <TextBlock x:Name="AiWeek" FontSize="13" Foreground="{StaticResource Dim}" />
                    <TextBlock Text="What the tokens would cost on the API, read from local logs." FontSize="11"
                               Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
                <ItemsControl x:Name="ModelList" Grid.Column="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelRow">
                            <Grid Padding="0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Model}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Tokens}" FontSize="13" Foreground="{StaticResource Dim}" FontFamily="Consolas" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Cost}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
