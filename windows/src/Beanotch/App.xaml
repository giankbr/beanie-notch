<Application
    x:Class="Beanotch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Accent" Color="#4D9EFF" />
            <SolidColorBrush x:Key="Ink" Color="#F2F2F2" />
            <SolidColorBrush x:Key="Dim" Color="#A1A1A1" />
            <SolidColorBrush x:Key="Faint" Color="#6B6B6B" />
            <SolidColorBrush x:Key="Surface" Color="#1B1B1D" />
            <SolidColorBrush x:Key="Stroke" Color="#2A2A2E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
